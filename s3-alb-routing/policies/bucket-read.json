{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheLabBucketOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadObjectsFromTheLabBucketOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    }
  ]
}
